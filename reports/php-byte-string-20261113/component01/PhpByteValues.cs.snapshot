using System;
using System.Collections.Generic;
using System.Globalization;
using System.Text;

namespace AllPhp.ByteValues
{
    // Isolated managed component. No interpreter integration or implicit text conversion.
    public sealed class PhpBytes : IEquatable<PhpBytes>
    {
        private readonly byte[] data;
        public static readonly PhpBytes Empty = new PhpBytes(new byte[0], true);
        private PhpBytes(byte[] bytes, bool owned) { data = owned ? bytes : (byte[])bytes.Clone(); }
        public static PhpBytes FromBytes(byte[] bytes) { if (bytes == null) throw new ArgumentNullException("bytes"); return new PhpBytes(bytes, false); }
        public static PhpBytes FromBase64(string value) { return new PhpBytes(Convert.FromBase64String(value), true); }
        public static PhpBytes FromUtf8(string value) { return new PhpBytes(new UTF8Encoding(false, true).GetBytes(value), true); }
        public long Length { get { return data.LongLength; } }
        public bool Truthy { get { return data.Length != 0 && !(data.Length == 1 && data[0] == 48); } }
        public byte[] ToArray() { return (byte[])data.Clone(); }
        public string ToBase64() { return Convert.ToBase64String(data); }
        public bool TryDecodeUtf8(out string text)
        {
            try { text = new UTF8Encoding(false, true).GetString(data); return true; }
            catch (DecoderFallbackException) { text = null; return false; }
        }
        public override string ToString() { throw new InvalidOperationException("PhpBytes requires an explicit raw-byte or strict decoded-text boundary"); }
        public bool Equals(PhpBytes other)
        {
            if (Object.ReferenceEquals(this, other)) return true;
            if ((object)other == null || data.Length != other.data.Length) return false;
            for (int i = 0; i < data.Length; ++i) if (data[i] != other.data[i]) return false;
            return true;
        }
        public override bool Equals(object other) { return Equals(other as PhpBytes); }
        public override int GetHashCode()
        {
            unchecked { uint hash = 2166136261; foreach (byte b in data) hash = (hash ^ b) * 16777619; return (int)hash; }
        }
        public PhpBytes Concat(PhpBytes right)
        {
            long length = Length + right.Length;
            if (length > Int32.MaxValue) throw new NotSupportedException("Prototype array storage lacks the planned 64-bit segmented backend");
            byte[] result = new byte[(int)length];
            Buffer.BlockCopy(data, 0, result, 0, data.Length); Buffer.BlockCopy(right.data, 0, result, data.Length, right.data.Length);
            return new PhpBytes(result, true);
        }
        public PhpBytes Slice(long offset, long? count)
        {
            long start = offset < 0 ? Math.Max(Length + offset, 0) : Math.Min(offset, Length);
            long end = Length;
            if (count.HasValue) end = count.Value < 0 ? Math.Max(start, Length + count.Value) : start + Math.Min(count.Value, Length - start);
            int length = checked((int)Math.Max(0, end - start));
            if (start == 0 && length == data.Length) return this;
            byte[] result = new byte[length]; if (length > 0) Buffer.BlockCopy(data, (int)start, result, 0, length);
            return new PhpBytes(result, true);
        }
        public OffsetResult ReadOffset(long offset)
        {
            long position = offset < 0 ? Length + offset : offset;
            if (position < 0 || position >= Length)
                return new OffsetResult(Empty, "", 2, "Uninitialized string offset " + offset.ToString(CultureInfo.InvariantCulture));
            return new OffsetResult(new PhpBytes(new byte[] { data[(int)position] }, true), "", 0, "");
        }
        public OffsetResult WithOffset(long offset, PhpBytes replacement)
        {
            long position = offset < 0 ? Length + offset : offset;
            if (position < 0) return new OffsetResult(this, "", 2, "Illegal string offset " + offset.ToString(CultureInfo.InvariantCulture));
            if (replacement.data.Length == 0) return new OffsetResult(this, "Error", 0, "Cannot assign an empty string to a string offset");
            if (position >= Int32.MaxValue) throw new NotSupportedException("Prototype array storage lacks the planned 64-bit segmented backend");
            int length = Math.Max(data.Length, checked((int)position + 1)); byte[] result = new byte[length];
            Buffer.BlockCopy(data, 0, result, 0, data.Length);
            for (int i = data.Length; i < length; ++i) result[i] = 32;
            result[(int)position] = replacement.data[0];
            return new OffsetResult(new PhpBytes(result, true), "", replacement.data.Length > 1 ? 2 : 0,
                replacement.data.Length > 1 ? "Only the first byte will be assigned to the string offset" : "");
        }
        public int CompareBinary(PhpBytes right)
        {
            int length = Math.Min(data.Length, right.data.Length);
            for (int i = 0; i < length; ++i) if (data[i] != right.data[i]) return (int)data[i] - right.data[i];
            return data.Length == right.data.Length ? 0 : data.Length < right.data.Length ? -1 : 1;
        }
        public PhpBytes LowerAscii()
        {
            byte[] result = (byte[])data.Clone();
            for (int i = 0; i < result.Length; ++i) if (result[i] >= 65 && result[i] <= 90) result[i] += 32;
            return new PhpBytes(result, true);
        }
        public PhpBytes BitwiseNot()
        {
            byte[] result = new byte[data.Length]; for (int i = 0; i < result.Length; ++i) result[i] = (byte)~data[i];
            return new PhpBytes(result, true);
        }
        public PhpBytes Bitwise(PhpBytes right, char operation)
        {
            if (operation != '&' && operation != '^' && operation != '|') throw new ArgumentOutOfRangeException("operation");
            int length = operation == '|' ? Math.Max(data.Length, right.data.Length) : Math.Min(data.Length, right.data.Length);
            byte[] result = new byte[length];
            for (int i = 0; i < length; ++i)
            {
                byte a = i < data.Length ? data[i] : (byte)0, b = i < right.data.Length ? right.data[i] : (byte)0;
                result[i] = operation == '&' ? (byte)(a & b) : operation == '^' ? (byte)(a ^ b) : (byte)(a | b);
            }
            return new PhpBytes(result, true);
        }
        public bool TryArrayInteger(out long value)
        {
            value = 0; if (data.Length == 0) return false;
            bool negative = data[0] == 45; int start = negative ? 1 : 0;
            if (start == data.Length) return false;
            if (data[start] == 48) { if (negative || data.Length != 1) return false; return true; }
            if (data[start] < 49 || data[start] > 57) return false;
            ulong limit = negative ? 9223372036854775808UL : 9223372036854775807UL, magnitude = 0;
            for (int i = start; i < data.Length; ++i)
            {
                if (data[i] < 48 || data[i] > 57) return false;
                uint digit = (uint)(data[i] - 48);
                if (magnitude > (limit - digit) / 10) return false;
                magnitude = magnitude * 10 + digit;
            }
            value = negative ? magnitude == 9223372036854775808UL ? Int64.MinValue : -(long)magnitude : (long)magnitude;
            return true;
        }
    }
    public sealed class OffsetResult
    {
        public readonly PhpBytes Value;
        public readonly string ErrorClass, Message;
        public readonly int WarningLevel;
        internal OffsetResult(PhpBytes value, string errorClass, int warningLevel, string message)
        { Value = value; ErrorClass = errorClass; WarningLevel = warningLevel; Message = message; }
    }
    public sealed class PhpKey : IEquatable<PhpKey>
    {
        private readonly bool integer; private readonly long number; private readonly PhpBytes bytes;
        private PhpKey(long value) { integer = true; number = value; }
        private PhpKey(PhpBytes value) { integer = false; bytes = value; }
        public static PhpKey FromInteger(long value) { return new PhpKey(value); }
        public static PhpKey FromString(PhpBytes value) { long integer; return value.TryArrayInteger(out integer) ? new PhpKey(integer) : new PhpKey(value); }
        public string Protocol { get { return integer ? "i:" + number.ToString(CultureInfo.InvariantCulture) : "s:" + bytes.ToBase64(); } }
        public bool Equals(PhpKey other)
        { return (object)other != null && integer == other.integer && (integer ? number == other.number : bytes.Equals(other.bytes)); }
        public override bool Equals(object other) { return Equals(other as PhpKey); }
        public override int GetHashCode() { return integer ? number.GetHashCode() ^ 0x15a36 : bytes.GetHashCode() ^ 0x2c6d9; }
    }
    public sealed class ByteEntry
    {
        public readonly PhpKey Key; public readonly PhpBytes Value;
        internal ByteEntry(PhpKey key, PhpBytes value) { Key = key; Value = value; }
    }
    public sealed class OrderedByteMap
    {
        private readonly List<ByteEntry> entries = new List<ByteEntry>();
        private readonly Dictionary<PhpKey, int> index = new Dictionary<PhpKey, int>();
        public void Set(PhpKey key, PhpBytes value)
        {
            int position;
            if (index.TryGetValue(key, out position)) entries[position] = new ByteEntry(entries[position].Key, value);
            else { index.Add(key, entries.Count); entries.Add(new ByteEntry(key, value)); }
        }
        public ByteEntry[] Snapshot() { return entries.ToArray(); }
    }
}
