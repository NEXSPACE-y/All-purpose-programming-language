+                    'int' {
+                        if ($value -is [bool]) {
+                            if ($value) { return [decimal]1 }
+                            return [decimal]0
+                        }
+                        if ($value -is [decimal]) {
+                            return [decimal]::Truncate($value)
+                        }
+                        if ($value -is [string]) {
+                            $parsed=[decimal]0
+                            if ([decimal]::TryParse($value,
+                                [System.Globalization.NumberStyles]::Float,
+                                [System.Globalization.CultureInfo]::InvariantCulture,
+                                [ref]$parsed)) {
+                                return [decimal]::Truncate($parsed)
+                            }
+                        }
+                    }
+                    'float' {
+                        if ($value -is [bool]) {
+                            if ($value) { return [decimal]1 }
