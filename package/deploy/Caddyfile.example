# Replace all.example.com with a domain under your control before deployment.
# Place ALL behind an HTTPS proxy; ALL must listen only on 127.0.0.1.
all.example.com {
    encode gzip zstd
    reverse_proxy 127.0.0.1:18888 {
        transport http {
            dial_timeout 3s
            response_header_timeout 30s
        }
    }
    log {
        output file /var/log/caddy/all_access.log {
            roll_size 50MiB
            roll_keep 10
        }
        format json
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
