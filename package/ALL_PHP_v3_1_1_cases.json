    "code": "<?php echo abs(-5);",
    "expected": "5"
  },
  {
    "name": "is_array",
    "code": "<?php $a=[1];echo is_array($a),\":\",is_array(\"test\");",
    "expected": "1:"
  },
  {
    "name": "is_string",
    "code": "<?php echo is_string(\"ok\"),\":\",is_string(2);",
    "expected": "1:"
  },
  {
    "name": "is_bool",
    "code": "<?php echo is_bool(true),\":\",is_bool(1);",
    "expected": "1:"
  },
  {
    "name": "strval",
    "code": "<?php echo \"x\",strval(13);",
